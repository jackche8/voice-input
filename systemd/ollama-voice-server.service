[Unit]
Description=Ollama Voice Input - Web 服务器
After=network.target ollama.service

[Service]
Type=simple
WorkingDirectory=/opt/ollama-voice-input
Environment=LD_LIBRARY_PATH=/opt/ollama-voice-input/.venv/lib/python3.12/site-packages/nvidia/cublas/lib:/opt/ollama-voice-input/.venv/lib/python3.12/site-packages/nvidia/cudnn/lib:/opt/ollama-voice-input/.venv/lib/python3.12/site-packages/nvidia/cuda_nvrtc/lib
ExecStart=/opt/ollama-voice-input/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 17945
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
